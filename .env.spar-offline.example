# ═══════════════════════════════════════════════════════════════════════════
# SPAR Option B-offline — local Ollama models (RTX 4060 Ti 8GB / 32GB RAM)
# ═══════════════════════════════════════════════════════════════════════════
# Copy into your main `.env` for Quorum UI runs, or use examples/spar_ollama_pilot.py
# directly (no API keys required).
#
# Pull models first (fast-thesis = 3 models, ~15 GB disk):
#   powershell -File scripts/pull_spar_offline_models.ps1 -Preset fast-thesis
#
# Pilot run (Liberation Day scenario):
#   uv run python examples/spar_ollama_pilot.py --preset fast-thesis --scenario liberation-day

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PARALLEL=1
QUORUM_EXECUTION_MODE=sequential
QUORUM_MODEL_TIMEOUT=300
QUORUM_REPORT_DIR=~/spar_outputs

# In Quorum /models, select these six (ollama: prefix added automatically):
#   fast-thesis preset:
#     ollama:llama3.1:8b     — Political, Social
#     ollama:qwen2.5:7b      — Economic, Environmental, Moderator
#     ollama:deepseek-r1:7b  — Devil's Advocate
#
#   thesis preset (five families — default):
#     ollama:llama3.1:8b, ollama:qwen2.5:7b, ollama:mistral:7b,
#     ollama:internlm2:7b, ollama:deepseek-r1:7b  (+ qwen for Moderator)
#
# GPT-OSS (OpenAI open weights): gpt-oss:20b needs ~16GB VRAM — NOT viable on RTX 4060 Ti 8GB.
# Use gpt-oss:20b-cloud via Ollama if you want OpenAI OSS without local GPU (not offline).
