# ═══════════════════════════════════════════════════════════════════════════
# SPAR Option B-offline — local Ollama models (RTX 4060 Ti 8GB / 32GB RAM)
# ═══════════════════════════════════════════════════════════════════════════
# Copy into your main `.env` for Quorum UI runs, or use examples/spar_ollama_pilot.py
# directly (no API keys required).
#
# Pull models first (demo-diverse = 6 families, ~22 GB disk):
#   powershell -File scripts/pull_spar_offline_models.ps1 -Preset demo-diverse
#
# Pilot run (Liberation Day scenario):
#   uv run python examples/spar_ollama_pilot.py --preset demo-diverse --scenario liberation-day

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PARALLEL=1
QUORUM_EXECUTION_MODE=sequential
QUORUM_MODEL_TIMEOUT=300
QUORUM_REPORT_DIR=~/spar_outputs
SPAR_SAVE_ARTIFACTS=true

# DCS explore/exploit controller (Layer 1 continuation)
SPAR_DCS_ENABLED=true
SPAR_DCS_THRESHOLD=0.35
SPAR_MAX_DEBATE_ROUNDS=5

# Layer 2 plausibility gate (consensus score 0-100)
SPAR_PLAUSIBILITY_GATE_ENABLED=true
SPAR_PLAUSIBILITY_THRESHOLD=60
SPAR_HUMAN_REVIEW_BLOCK=true

# FSR + Layer 3
SPAR_FSR_BENCHMARK_ENABLED=true
SPAR_FSR_MODERATOR_WEIGHT=0.55
SPAR_FSR_WEIGHT=0.45
SPAR_LAYER3_ENABLED=true

# demo-diverse preset (default — six model families):
#   ollama:granite3.3:8b   — Political (IBM)
#   ollama:qwen2.5:7b      — Economic (Alibaba)
#   ollama:mistral:7b      — Environmental (Mistral)
#   ollama:gemma3:4b       — Social (Google)
#   ollama:nemotron-mini:4b — Devil's Advocate (NVIDIA)
#   ollama:phi4-mini       — Moderator (Microsoft)
